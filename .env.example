# Renewable Energy Intelligence Platform - Environment Configuration

# Database: Supabase Configuration
# Provide your Supabase project credentials (URL and API key).
# If left empty, the platform automatically runs with an embedded SQLite persistence layer
# with identical tables, views, and schemas for seamless offline and testing operation.
SUPABASE_URL=https://peorszycvpdktejoqggi.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after applying and verifying the normalized energy platform migration.
SUPABASE_NORMALIZED_SCHEMA_ENABLED=False
# Optional private bucket for an extra copy of uploaded files; backend service-role access is required.
SUPABASE_DATASET_STORAGE_BUCKET=
DATASET_MAX_UPLOAD_MB=100
DATASET_UPLOAD_DIR="datasets/uploads"
DATABASE_URL=

# Environment and Runtime
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Apache Spark Configuration
SPARK_APP_NAME="RenewableEnergyIntelligencePlatform"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY="2g"
SPARK_EXECUTOR_MEMORY="2g"
JAVA_HOME="C:\Program Files\Java\jdk-17"

# External Data API Endpoints & Configuration
NASA_POWER_API_BASE="https://power.larc.nasa.gov/api/temporal"
OWID_ENERGY_CSV_URL="https://catalog.ourworldindata.org/energy/owid_energy/owid_energy.csv"
OPEN_METEO_API_BASE="https://api.open-meteo.com/v1"

# Scheduler Configuration
WEATHER_SYNC_INTERVAL_HOURS=1
OWID_SYNC_INTERVAL_DAYS=30
NASA_POWER_SYNC_INTERVAL_DAYS=7

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
JWT_SECRET="renewable-energy-intelligence-secret-key-32-chars-min"
